rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow read: if owns(userId) || isAdmin();
      allow create: if owns(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'customer';
      allow update: if owns(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerUserId == request.auth.uid);
      allow write: if false;
    }

    match /shippingZones/{zoneId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /payments/{document=**} { allow read, write: if false; }
    match /webhookEvents/{document=**} { allow read, write: if false; }
    match /inventoryMovements/{document=**} { allow read: if isAdmin(); allow write: if false; }
    match /auditLogs/{document=**} { allow read: if isAdmin(); allow write: if false; }
    match /discountCodes/{document=**} { allow read, write: if isAdmin(); }
  }
}
